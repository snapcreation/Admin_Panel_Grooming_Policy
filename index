    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 15px;
    border-bottom: 1px solid var(--border-dim);
}

.modal-title {
    color: var(--neon-green);
    font-size: 10px;
    letter-spacing: 1px;
}

.modal-close {
    color: var(--neon-red);
