/* =========================================================
   SELECT
   ========================================================= */

function toggleSelectRow(
    index,
    checked
) {

    if (checked) {

        selectedRows.add(index);

    } else {

        selectedRows.delete(index);

    }

}


function selectAll() {

    selectedRows.clear();


    filteredRecords.forEach(
        function (_, index) {

            selectedRows.add(index);

        }
    );


    renderAuditTable();

}


function deselectAll() {

    selectedRows.clear();

    renderAuditTable();

}


/* =========================================================
   DRIVE FILE ID
   ========================================================= */

function extractDriveFileId(url) {

    if (!url) {
        return "";
    }


    const text =
        String(url);


    const patterns = [

        /[?&]id=([a-zA-Z0-9_-]+)/,

        /\/d\/([a-zA-Z0-9_-]+)/,

        /googleusercontent\.com\/d\/([a-zA-Z0-9_-]+)/

    ];


    for (
        const pattern of patterns
    ) {

        const match =
            text.match(pattern);


        if (
            match &&
            match[1]
        ) {

            return match[1];

        }

    }


    return "";

}


/* =========================================================
   VIDEO DETECTION
   ========================================================= */

function isVideoRecord(
    record,
    url
) {

    const type =
        String(
            record.mediaType ||
            ""
        ).toLowerCase();


    const name =
        String(
            record.mediaFileName ||
            record.mediaLabel ||
            ""
        ).toLowerCase();


    const source =
        String(
            url ||
            ""
        ).toLowerCase();


    return (

        type.includes("video") ||

        /\.(mp4|webm|mov|m4v|avi|3gp)(\?|$)/i
            .test(name) ||

        /\.(mp4|webm|mov|m4v|avi|3gp)(\?|$)/i
            .test(source)

    );

}


