<style>
:root {
    --bg: #05080b;
    --panel: #0b1117;
    --panel2: #0f171e;
    --border-dim: #1b2a35;
    --text: #d9e4ea;
    --text-muted: #71818c;

    --neon-green: #00ff9d;
    --neon-red: #ff3158;
    --neon-amber: #ffc400;
    --neon-blue: #00b7ff;
    --neon-purple: #b86cff;

    --shadow-green: 0 0 20px rgba(0,255,157,.12);
    --shadow-red: 0 0 20px rgba(255,49,88,.12);
}

* {
    box-sizing: border-box;
}

html,
body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    background: var(--bg);
    color: var(--text);
    font-family: "Segoe UI", Arial, sans-serif;
}

body {
    overflow-x: hidden;
}

button,
input,
select {
    font: inherit;
}

button {
    cursor: pointer;
}

a {
    color: inherit;
}

/* =========================================================
   MAIN DASHBOARD
   ========================================================= */

#dashboard {
    min-height: 100vh;
    padding: 18px;
}

.dashboard-container {
    max-width: 1600px;
    margin: auto;
}

.top-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 17px;
    background: var(--panel);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    margin-bottom: 15px;
}

.brand-title {
    color: var(--neon-green);
    font-size: clamp(16px, 2vw, 24px);
    font-weight: 700;
    letter-spacing: 2px;
}

.brand-subtitle {
    margin-top: 5px;
    color: var(--text-muted);
    font-size: 10px;
    letter-spacing: 1px;
}

.header-status {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--neon-green);
    font-size: 9px;
    letter-spacing: 1px;
}

.status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--neon-green);
    box-shadow: 0 0 8px var(--neon-green);
    animation: pulseDot 1.2s infinite;
}

@keyframes pulseDot {
    0%,100% {
        opacity: 1;
    }

    50% {
        opacity: .3;
    }
}

/* =========================================================
   CONTROLS
   ========================================================= */

.controls-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 12px;
    background: var(--panel);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    margin-bottom: 15px;
}

.filter-btn {
    padding: 8px 11px;
    border: 1px solid var(--border-dim);
    border-radius: 4px;
    background: #091016;
    color: var(--text-muted);
    font-size: 10px;
}

.filter-btn.active {
    color: var(--neon-green);
    border-color: var(--neon-green);
    background: rgba(0,255,157,.05);
}

.filter-select,
.search-input {
    padding: 8px 10px;
    min-width: 150px;
    background: #091016;
    color: var(--text);
    border: 1px solid var(--border-dim);
    border-radius: 4px;
    outline: none;
    font-size: 10px;
}

.search-input {
    flex: 1;
    min-width: 220px;
}

.filter-select:focus,
.search-input:focus {
    border-color: var(--neon-blue);
}

.btn {
    border: 1px solid var(--border-dim);
    background: #0c141b;
    color: var(--text);
    border-radius: 4px;
    padding: 9px 13px;
    transition: .2s;
}

.btn:hover {
    border-color: var(--neon-blue);
    color: white;
}

.btn:disabled {
    opacity: .55;
    cursor: not-allowed;
}

.btn-green {
    border-color: var(--neon-green);
    color: var(--neon-green);
    background: rgba(0,255,157,.04);
    box-shadow: 0 0 12px rgba(0,255,157,.06);
}

.btn-green:hover {
    background: rgba(0,255,157,.1);
}

.btn-amber {
    border-color: var(--neon-amber);
    color: var(--neon-amber);
}

.btn-red {
    border-color: var(--neon-red);
    color: var(--neon-red);
}

/* =========================================================
   KPI
   ========================================================= */

.kpi-grid {
    display: grid;
    grid-template-columns:
        repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 15px;
}

.kpi-card {
    padding: 16px;
    background: var(--panel);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    min-height: 105px;
}

.kpi-label {
    color: var(--text-muted);
    font-size: 9px;
    letter-spacing: 1px;
}

.kpi-value {
    margin-top: 10px;
    font-size: 25px;
    font-weight: 700;
}

.kpi-green {
    color: var(--neon-green);
}

.kpi-red {
    color: var(--neon-red);
}

.kpi-amber {
    color: var(--neon-amber);
}

.kpi-blue {
    color: var(--neon-blue);
}

/* =========================================================
   CHARTS
   ========================================================= */

.chart-grid {
    display: grid;
    grid-template-columns:
        repeat(2, minmax(0, 1fr));
    gap: 15px;
    margin-bottom: 15px;
}

.panel {
    background: var(--panel);
    border: 1px solid var(--border-dim);
    border-radius: 6px;
    overflow: hidden;
}

.panel-header {
    padding: 12px 14px;
    border-bottom: 1px solid var(--border-dim);
    color: var(--neon-blue);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
}

.chart-container {
    position: relative;
    height: 300px;
    padding: 15px;
}

/* =========================================================
   REPEAT MATRIX
   ========================================================= */

.repeat-table-wrapper {
    overflow-x: auto;
}

.repeat-table,
.audit-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 900px;
}

.repeat-table th,
.repeat-table td,
.audit-table th,
.audit-table td {
