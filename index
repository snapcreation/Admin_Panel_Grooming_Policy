<script>

/* =========================================================
   CONFIGURATION
   ========================================================= */

const SCRIPT_URL =
    "https://script.google.com/macros/s/AKfycbyQ8i4MvS1NmYZ5Au4tV7N4tz6WKibn0Yu3cA15dGDwc78ip5lNwAsU5Vz7DxHNXYFp/exec";


/* =========================================================
   APPLICATION STATE
   ========================================================= */

let allRecords = [];

let filteredRecords = [];

let selectedRows = new Set();

let currentTimespan = "all";

let ccChartInst = null;

let policyChartInst = null;


/* =========================================================
   GENERIC RESPONSE PARSER
   ========================================================= */

async function readServerResponse(response) {

    const rawText =
        await response.text();

    let data = null;

    try {

        data =
            JSON.parse(rawText);

    } catch (error) {

        console.error(
            "Invalid JSON response:",
            rawText
        );

        throw new Error(
            "Backend returned an invalid response. HTTP " +
            response.status
        );

    }

    if (!response.ok) {

        throw new Error(
            data &&
            data.message
                ? data.message
                : "Server returned HTTP " +
                  response.status
        );

    }

    return data;

}


/* =========================================================
   RECORD FETCH
   ========================================================= */

async function fetchRecords() {

    try {

        const response =
            await fetch(
                `${SCRIPT_URL}?action=records`,
                {
                    method: "GET",
                    cache: "no-store"
                }
            );


        const data =
            await readServerResponse(
                response
            );


        console.log(
            "RECORDS RESPONSE:",
            data
        );


        if (
            data &&
            data.success &&
            Array.isArray(data.records)
        ) {

            allRecords =
                data.records;

            populateCCDropdown();

            applyFilters();

            return;

        }


        console.warn(
            "Records response:",
            data
        );


        if (
            data &&
            data.message
        ) {

            console.error(
                data.message
            );

        }


    } catch (error) {

        console.error(
            "Fetch records error:",
            error
        );

    }

}


/* =========================================================
   CC DROPDOWN
   ========================================================= */

function populateCCDropdown() {

    const select =
        document.getElementById(
            "ccFilter"
        );

    if (!select) {
        return;
    }

    const current =
        select.value;

    const ccSet =
        new Set();

    allRecords.forEach(
        function (record) {

            if (record.cc) {

                ccSet.add(
                    String(record.cc).trim()
                );

            }

        }
    );

    select.innerHTML =
        '<option value="all">ALL CC</option>';

    Array.from(ccSet)
        .sort()
        .forEach(
            function (cc) {

                const option =
                    document.createElement(
                        "option"
                    );

                option.value =
                    cc;

                option.textContent =
                    cc;

                select.appendChild(
                    option
                );

            }
        );

    if (
        Array.from(
            select.options
        ).some(
            option =>
                option.value === current
        )
    ) {

        select.value =
            current;

    }

}


/* =========================================================
   TIME FILTER
   ========================================================= */

function setTimeSpan(span) {

    currentTimespan =
        span;

    [
        "spanAll",
        "spanYear",
        "spanMonth",
        "spanToday"
    ].forEach(
        function (id) {

            const button =
                document.getElementById(
                    id
                );

            if (button) {

                button.classList.remove(
                    "active"
                );

            }

        }
    );

    const map = {

        all: "spanAll",

        year: "spanYear",

        month: "spanMonth",

        today: "spanToday"

    };

    if (map[span]) {

        document.getElementById(
            map[span]
        ).classList.add(
            "active"
        );

    }

    applyFilters();

}


/* =========================================================
   DATE NORMALIZATION
   ========================================================= */

function normalizeDate(value) {

    if (!value) {
        return null;
    }

    const text =
        String(value).trim();


    /*
     * DD/MM/YYYY
     * DD-MM-YYYY
     */

    const match =
        text.match(
            /^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/
        );


    if (match) {

        let year =
            Number(match[3]);

        if (year < 100) {
            year += 2000;
        }

        return new Date(
            year,
            Number(match[2]) - 1,
            Number(match[1])
        );

    }


    const date =
        new Date(value);

    if (!isNaN(date.getTime())) {

        return date;

    }

    return null;

}


/* =========================================================
   FILTER
   ========================================================= */

function applyFilters() {

    const ccElement =
        document.getElementById(
            "ccFilter"
        );

    const searchElement =
        document.getElementById(
            "searchInput"
        );


    const cc =
        ccElement
            ? ccElement.value
            : "all";


    const search =
        searchElement
            ? searchElement.value
                .trim()
                .toLowerCase()
            : "";


    const now =
        new Date();


    filteredRecords =
        allRecords.filter(
            function (record) {

                if (
                    cc !== "all" &&
                    String(
                        record.cc || ""
                    ).trim() !== cc
                ) {

                    return false;

                }


                if (search) {

                    const haystack =
                        [
                            record.empName,
                            record.empId,
                            record.empDesignation,
                            record.violation,
                            record.violationId,
                            record.cc,
                            record.remarks,
                            record.policyRemarks
                        ]
                        .join(" ")
                        .toLowerCase();


                    if (
                        !haystack.includes(
                            search
                        )
                    ) {

                        return false;

                    }

                }


                if (
                    currentTimespan === "all"
                ) {

                    return true;

                }


                const date =
                    normalizeDate(
                        record.incidentDate
                    );


                if (!date) {

                    return true;

                }


                if (
                    currentTimespan === "year"
                ) {

                    return (
                        date.getFullYear() ===
                        now.getFullYear()
                    );

                }


                if (
                    currentTimespan === "month"
                ) {

                    return (
                        date.getFullYear() ===
                            now.getFullYear() &&
                        date.getMonth() ===
                            now.getMonth()
                    );

                }


                if (
                    currentTimespan === "today"
                ) {

                    return (
                        date.getFullYear() ===
                            now.getFullYear() &&
                        date.getMonth() ===
                            now.getMonth() &&
                        date.getDate() ===
                            now.getDate()
                    );

                }


                return true;

            }
        );


    renderKPIs();

    renderCharts();

    renderRepeatOffenders();

    renderAuditTable();

}


/* =========================================================
   NUMBER
   ========================================================= */

function numberValue(value) {

    if (
        value === null ||
        value === undefined ||
        value === ""
    ) {

        return 0;

    }

    const cleaned =
        String(value)
            .replace(/,/g, "")
            .replace(/[₹$]/g, "")
            .trim();


    const number =
        Number(cleaned);


    return isNaN(number)
        ? 0
        : number;

}


/* =========================================================
   KPI
   ========================================================= */

function renderKPIs() {

    let penalty = 0;

    let cost = 0;

    let fund = 0;


    filteredRecords.forEach(
        function (record) {

            penalty +=
                numberValue(
                    record.penalty
                );

            cost +=
                numberValue(
                    record.applicableCost
                );

            fund +=
                numberValue(
                    record.employeeFund
                );

        }
    );


    document.getElementById(
        "kpiTotal"
    ).innerText =
        filteredRecords.length;


    document.getElementById(
        "kpiPenalty"
    ).innerText =
        formatCurrency(penalty);


    document.getElementById(
        "kpiCost"
    ).innerText =
        formatCurrency(cost);


    document.getElementById(
        "kpiFund"
    ).innerText =
        formatCurrency(fund);

}


/* =========================================================
   CURRENCY
   ========================================================= */

function formatCurrency(value) {

    return "₹" +
        Number(value || 0)
            .toLocaleString(
                "en-IN",
                {
                    maximumFractionDigits: 2
                }
            );

}


/* =========================================================
   CHARTS
   ========================================================= */

function renderCharts() {

    const ccCounts = {};

    const policyCounts = {};


    filteredRecords.forEach(
        function (record) {

            const cc =
                String(
                    record.cc ||
                    "UNKNOWN"
                ).trim();


            ccCounts[cc] =
                (ccCounts[cc] || 0) + 1;


            const policy =
                String(
                    record.violation ||
                    record.violationId ||
                    "UNKNOWN"
                ).trim();


            policyCounts[policy] =
                (policyCounts[policy] || 0) + 1;

        }
