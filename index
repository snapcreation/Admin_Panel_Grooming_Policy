    border-bottom: 1px solid var(--border-dim);
    text-align: left;
    font-size: 10px;
}

.repeat-table th,
.audit-table th {
    color: var(--text-muted);
    background: #091016;
    font-size: 9px;
    letter-spacing: .7px;
    white-space: nowrap;
}

.repeat-table td,
.audit-table td {
    color: var(--text);
}

.repeat-table tr:hover,
.audit-table tr:hover {
    background: rgba(0,183,255,.025);
}

/* =========================================================
   AUDIT TABLE
   ========================================================= */

.audit-toolbar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    padding: 10px;
    border-bottom: 1px solid var(--border-dim);
}

.audit-scroll {
    overflow-x: auto;
    max-height: 600px;
    overflow-y: auto;
}

.badge {
    display: inline-block;
    padding: 4px 7px;
    border-radius: 3px;
    border: 1px solid var(--border-dim);
    font-size: 8px;
    white-space: nowrap;
}

.badge-green {
    color: var(--neon-green);
    border-color: rgba(0,255,157,.4);
}

.badge-red {
    color: var(--neon-red);
    border-color: rgba(255,49,88,.4);
}

.badge-amber {
    color: var(--neon-amber);
    border-color: rgba(255,196,0,.4);
}

.view-btn {
    padding: 5px 8px;
    color: var(--neon-blue);
    background: transparent;
    border: 1px solid rgba(0,183,255,.4);
    border-radius: 3px;
    font-size: 8px;
}

.view-btn:hover {
    background: rgba(0,183,255,.08);
}

.checkbox {
    accent-color: var(--neon-green);
}

/* =========================================================
   EVIDENCE MODAL
   ========================================================= */

.evidence-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 90000;
    align-items: center;
    justify-content: center;
    padding: 20px;
