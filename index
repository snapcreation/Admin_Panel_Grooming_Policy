/* =========================================================
   REPEAT OFFENDERS
   ========================================================= */

function renderRepeatOffenders() {

    const body =
        document.getElementById(
            "repeatBody"
        );


    if (!body) {
        return;
    }


    body.innerHTML = "";


    const map = {};


    filteredRecords.forEach(
        function (record) {

            const id =
                String(
                    record.empId ||
                    record.empName ||
                    "UNKNOWN"
                ).trim();


            if (!map[id]) {

                map[id] = {

                    name:
                        record.empName ||
                        "UNKNOWN",

                    id:
                        record.empId ||
                        "",

                    designation:
                        record.empDesignation ||
                        "",

                    count: 0,

                    penalty: 0

                };

            }


            map[id].count++;


            map[id].penalty +=
                numberValue(
                    record.penalty
                );

        }
    );


    const rows =
        Object.values(map)
            .filter(
                row =>
                    row.count > 1
            )
            .sort(
                (a, b) =>
                    b.count - a.count
            );


    if (!rows.length) {

        body.innerHTML = `

            <tr>

                <td
                    colspan="5"
                    style="
                        text-align:center;
                        color:var(--text-muted);
                    "
                >

                    NO REPEAT INFRACTIONS FOUND

                </td>

            </tr>

        `;

        return;

    }


    rows.forEach(
        function (row) {

            const tr =
                document.createElement(
                    "tr"
                );


            tr.innerHTML = `

                <td>
                    ${escapeHtml(row.name)}
                </td>

                <td>
                    ${escapeHtml(row.id)}
                </td>

                <td>
                    ${escapeHtml(row.designation)}
                </td>

                <td>

                    <span class="badge badge-red">
                        ${row.count}
                    </span>

                </td>

                <td>
                    ${formatCurrency(
                        row.penalty
                    )}
                </td>

            `;


            body.appendChild(tr);

        }
    );

}


/* =========================================================
   ESCAPE HTML
   ========================================================= */

function escapeHtml(value) {

    return String(
        value ?? ""
    ).replace(
        /[&<>"']/g,
        function (char) {

            const map = {

                "&": "&amp;",

                "<": "&lt;",

                ">": "&gt;",

                '"': "&quot;",

                "'": "&#039;"

            };


            return map[char];

        }
    );

}


