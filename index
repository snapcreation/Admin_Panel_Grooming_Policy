                    );

                };


        } else {

            container.innerHTML = `

                <div style="
                    width:100%;
                    display:flex;
                    flex-direction:column;
                    align-items:center;
                    gap:12px;
                ">

                    <img
                        id="evidenceImage"
                        src="${imageUrl}"
                        alt=""
                        style="
                            max-width:100%;
                            max-height:65vh;
                            object-fit:contain;
                            border:1px solid var(--border-dim);
                            border-radius:4px;
                            background:#000;
                        "
                    >


                    <div style="
                        display:flex;
                        gap:10px;
                        flex-wrap:wrap;
                        justify-content:center;
                    ">

                        <a
                            href="${previewUrl}"
                            target="_blank"
                            rel="noopener"
                            class="btn btn-green"
                            style="text-decoration:none;"
                        >
                            OPEN IN DRIVE PREVIEW
                        </a>


                        <a
                            href="${downloadUrl}"
                            target="_blank"
                            rel="noopener"
                            class="btn btn-amber"
                            style="text-decoration:none;"
                        >
                            OPEN / DOWNLOAD FILE
                        </a>

                    </div>

                </div>

            `;


            const image =
                document.getElementById(
                    "evidenceImage"
                );


            image.onerror =
