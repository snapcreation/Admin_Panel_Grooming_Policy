/* =========================================================
   EXCEL EXPORT
   ========================================================= */

function exportExcel() {

    if (
        !filteredRecords.length
    ) {

        alert(
            "NO RECORDS AVAILABLE FOR EXPORT."
        );

        return;

    }


    const rows =
        filteredRecords.map(
            function (record) {

                return {

                    "S.NO":
                        record.sNo || "",

                    "CC":
                        record.cc || "",

                    "Violation ID":
                        record.violationId || "",

                    "Violation / Incident":
                        record.violation || "",

                    "Incident Date":
                        record.incidentDate || "",

                    "Incident Time":
                        record.incidentTime || "",

                    "Employee ID":
                        record.empId || "",

                    "Employee Name":
                        record.empName || "",

                    "Designation":
                        record.empDesignation || "",

                    "Evidence Type":
                        record.mediaType || "",

                    "Evidence File Name":
                        record.mediaFileName || "",

                    "Evidence Drive URL":
                        record.mediaUrl || "",

                    "Report Employee ID":
                        record.reportEmployeeId || "",

                    "Report Name":
                        record.reportName || "",

                    "Report Designation":
                        record.reportDesignation || "",

                    "Penalty":
                        record.penalty || "",

                    "Applicable Cost":
                        record.applicableCost || "",

                    "Employee Fund":
                        record.employeeFund || "",

                    "Policy Remarks":
                        record.policyRemarks || "",

                    "Remarks":
                        record.remarks || "",

                    "Created At":
                        record.createdAt || "",

                    "Saved At":
                        record.savedAt || ""

                };

            }
        );


    const worksheet =
        XLSX.utils.json_to_sheet(
            rows
        );


    const workbook =
        XLSX.utils.book_new();


    XLSX.utils.book_append_sheet(
        workbook,
        worksheet,
        "Audit Report"
    );


    XLSX.writeFile(
        workbook,
        "Grooming_Audit_Report.xlsx"
    );

}


/* =========================================================
   INITIALIZATION
   ========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function () {

        /*
         * Dashboard opens directly.
         * No username.
         * No password.
         * No OTP.
         * No camera.
         * No authentication token.
         */

        fetchRecords();


        /*
         * Automatically refresh records
         * every 30 seconds.
         */

        setInterval(
            function () {

                fetchRecords();

            },
            30000
        );


        /*
         * Close evidence modal
         * when clicking outside it.
         */

        const evidenceModal =
            document.getElementById(
                "evidenceModal"
            );


        if (evidenceModal) {

            evidenceModal.addEventListener(
                "click",
                function (event) {

                    if (
                        event.target === this
                    ) {

                        closeModal();

                    }

                }
            );

        }

    }
);

